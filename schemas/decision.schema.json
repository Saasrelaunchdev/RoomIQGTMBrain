{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Saasrelaunchdev/RoomIQGTMBrain/schemas/decision.schema.json",
  "title": "Decision",
  "description": "A dated strategic call. One entry of ops/decisions.md.",
  "type": "object",
  "required": [
    "id",
    "date",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^D-\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DECIDED",
        "WORKING",
        "OPEN"
      ]
    },
    "body": {
      "type": "string"
    }
  }
}
